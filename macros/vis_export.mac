# Historical macro: references MCP index 1 volumes from an older multi-MCP
# geometry. With the current kNumberOfMCPs = 1 geometry, use vis_current.mac
# for interactive viewing.
/control/verbose 0
/run/initialize

/vis/open OGLSX
/vis/verbose errors

# Vector OpenGL export does not preserve transparent surfaces reliably.
# Keep the same colours but make the exported MCP bodies opaque.
/vis/geometry/set/colour MCP_plus_body_0_log 0 0.10 0.35 1.00 1.00
/vis/geometry/set/colour MCP_plus_body_1_log 0 0.10 0.35 1.00 1.00
/vis/geometry/set/colour MCP_minus_body_0_log 0 0.10 0.80 0.35 1.00
/vis/geometry/set/colour MCP_minus_body_1_log 0 0.10 0.80 0.35 1.00
/vis/geometry/set/colour MCP_plus_channel_0_log 0 1.00 0.25 0.05 1.00
/vis/geometry/set/colour MCP_plus_channel_1_log 0 1.00 0.25 0.05 1.00
/vis/geometry/set/colour MCP_minus_channel_0_log 0 1.00 0.25 0.05 1.00
/vis/geometry/set/colour MCP_minus_channel_1_log 0 1.00 0.25 0.05 1.00

/vis/scene/create
/vis/scene/add/volume MCP_plus_body_0 -1 1
/vis/scene/add/volume MCP_plus_body_1 -1 1
/vis/scene/add/volume MCP_minus_body_0 -1 1
/vis/scene/add/volume MCP_minus_body_1 -1 1
/vis/scene/add/axes 0 0 0 5 cm
/vis/sceneHandler/attach
/vis/viewer/set/background white
/vis/viewer/set/style surface
/vis/viewer/set/hiddenEdge true
/vis/viewer/set/auxiliaryEdge true
/vis/viewer/set/culling coveredDaughters false
/vis/viewer/set/viewpointThetaPhi 70 25
/vis/viewer/set/targetPoint 0 0 0 cm
/vis/viewer/zoomTo 0.75
/vis/viewer/flush

# The file is written in the directory from which the executable is launched.
/vis/ogl/export mcp_pet_geometry.svg
