# Balayage du nombre de plaques par cote. Une ligne de ScanTree par point.
# ~12 M de canaux au point a 4 plaques : decommenter plateRadius pour tester.

/control/verbose 0
/run/verbose 0
/event/verbose 0
/tracking/verbose 0
/random/setSeeds 42 4242

/control/macroPath .:macros:../macros:../../macros
/control/execute geometry.mac
/control/execute source.mac

/mcp/killGammaOnExit false
# /mcp/plateRadius 2 mm
/source/print

/output/scanFile scan_stacks.root
/run/initialize

/control/alias events 2000
/control/foreach scan_point.mac stacks "1 2 3 4"
